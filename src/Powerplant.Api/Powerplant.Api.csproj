<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Powerplant.Api</RootNamespace>
    <AssemblyName>Powerplant.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageReference Include="NSwag.MSBuild" Version="14.7.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Contracts\openapi.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="nswag.json" />
  </ItemGroup>

  <!-- Generated files are added by the target below after NSwag has refreshed them. -->
  <ItemGroup>
    <Compile Remove="Generated\**\*.g.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Generated\ProductionPlanControllerBase.g.cs" />
  </ItemGroup>

    <Target Name="GenerateControllersFromOpenApi" BeforeTargets="CoreCompile">
        <MakeDir Directories="$(ProjectDir)Generated" />

        <Exec WorkingDirectory="$(ProjectDir)" Command="$(NSwagExe_Net90) run nswag.json" />

        <ItemGroup>
            <Compile Include="$(ProjectDir)Generated\**\*.g.cs" />
        </ItemGroup>
    </Target>

</Project>
